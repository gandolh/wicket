{
  "name": "wicket",
  "version": "0.1.0",
  "description": "One small door to an LLM for every app in the estate: one queue, one call at a time.",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -b shared && concurrently --names server,web --kill-others-on-fail \"npm run dev -w @wicket/server\" \"npm run dev -w @wicket/web\"",
    "build": "tsc -b && npm run build -w @wicket/web",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p web --noEmit",
    "lint": "eslint .",
    "docs": "npm run docs --prefix docs-site"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
