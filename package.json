{
  "name": "wicket",
  "version": "0.1.0",
  "description": "One small door to an LLM for every app in the estate: one queue, one call at a time.",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -b shared && npm run dev -w @wicket/server",
    "build": "tsc -b",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.12"
  },
  "license": "MIT"
}
