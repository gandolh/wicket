{
  "name": "wicket",
  "version": "0.1.0",
  "description": "One small door to an LLM for every app in the estate: one queue, one call at a time.",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -b shared && concurrently --names server,web --kill-others-on-fail \"npm run dev -w @wicket/server\" \"npm run dev -w @wicket/web\"",
    "build": "tsc -b && npm run build -w @wicket/web",
    "start": "node server/dist/server.js",
    "pretest": "tsc -b shared",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p web --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check:conventions": "knip && depcruise server/src web/src shared/src && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs",
    "docs": "npm run docs --prefix docs-site",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "10.0.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
