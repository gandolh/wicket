{
  "$schema": "../vendor/house-style/conventions.schema.json",
  "web": ["web/src"],
  "server": ["server/src"],
  "shared": ["shared/src"],
  "exceptions": [
    {
      "check": "structure",
      "rule": 6,
      "path": "server/src/plugins/page.ts",
      "match": "GET / declares no schema",
      "reason": "The redirect to the page: a 302 with no body and no input, so there is nothing for a schema to declare."
    }
  ]
}
