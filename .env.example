# Copy to .env (gitignored) for local development. No value is ever committed.
# The server reads this file for whatever the environment leaves unset.

# Where the server listens. The defaults suit local development.
HOST=127.0.0.1
PORT=8808
# The SQLite file (records only, never text). Empty means data/wicket.sqlite
# under the repo root.
WICKET_DB=

# SECRET. Each app's bearer token: app=token pairs, comma-separated, each token
# at least 32 characters (`openssl rand -hex 32`). The app puts the same token
# in its own WICKET_TOKEN. Empty refuses every job call.
# Example shape: just-a-bot=<token>,ro-housing=<token>
WICKET_APP_TOKENS=

# SECRET. The Ollama Cloud key. Wicket asks Ollama Cloud only: with this
# empty, every job ends failed with "OLLAMA_API_KEY is not set", and the queue
# still works.
OLLAMA_API_KEY=
# The cloud model and where it is. These are the defaults.
# WICKET_CLOUD_URL=https://ollama.com
# WICKET_CLOUD_MODEL=gpt-oss:120b
# WICKET_CLOUD_TIMEOUT_SECONDS=120

# The page's own origin as the browser sees it. Empty means the Vite dev
# server, http://localhost:5179. For `npm start` (the built page on the
# server's own port) set it to http://127.0.0.1:8808, or signing in is refused.
PUBLIC_ORIGIN=
# The API prefix and the page's base path as the browser sees them. These are the defaults.
# WICKET_API_PREFIX=/wicket-api
# WICKET_BASE=/wicket/

# Peers besides loopback whose X-Forwarded-For the login lockout believes:
# comma-separated addresses or CIDR ranges. Empty is right locally.
AUTH_TRUSTED_PROXIES=

# The one local user, made by `npm run seed -w @wicket/server`, which asks on
# the terminal for whatever is empty here. An existing user is left as it is.
SEED_USERNAME=
SEED_PASSWORD=

# "Sign in with Ward" (optional): Ward's local seed writes these five. With
# WARD_OIDC_ISSUER empty the server runs with local accounts only.
# WARD_OIDC_CLIENT_KEY is a SECRET.
WARD_OIDC_ISSUER=
WARD_OIDC_CLIENT_ID=
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=
