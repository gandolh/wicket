# Copy to .env (gitignored) for local development. No value is ever committed.
# The server reads this file for whatever the environment leaves unset.

# Where the server listens. The defaults suit local development.
HOST=127.0.0.1
PORT=8808
# The SQLite file (records only, never text). Empty means data/wicket.sqlite
# under the repo root.
WICKET_DB=

# SECRET. Each app's bearer token: app=token pairs, comma-separated, each token
# at least 32 characters (`openssl rand -hex 32`). The app puts the same token
# in its own WICKET_TOKEN. Empty refuses every job call.
# Example shape: just-a-bot=<token>,ro-housing=<token>
WICKET_APP_TOKENS=
