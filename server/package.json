{
  "name": "@wicket/server",
  "version": "0.1.0",
  "description": "The Wicket API (Fastify + SQLite): the queue, the providers and the records; it also serves the built page.",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-zod": "1.0.3",
    "@wicket/shared": "0.1.0",
    "better-sqlite3": "13.0.3",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "tsx": "4.23.13"
  }
}
